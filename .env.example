# Optional runtime paths. Keep real values in your shell or a local, ignored .env.
FOSSPULSER_DATA_DIR=/absolute/path/to/local/fosspulser-data
FOSSPULSER_WORKER=/absolute/path/to/pixi/environment/bin/python

# Optional Copernicus Marine credentials. GUI-entered values are session-only.
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
